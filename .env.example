# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_assistant?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-assistant
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey_change_me_in_prod

# WhatsApp Meta Cloud API
WHATSAPP_VERIFY_TOKEN=whatsapp-verify-token
WHATSAPP_API_VERSION=v21.0
# Per-tenant credentials stored in DB; optional global fallback:
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Google Business Profile
GOOGLE_BUSINESS_SCOPES=https://www.googleapis.com/auth/business.manage

# App
NODE_ENV=development
PUBLIC_QUOTE_BASE_URL=http://localhost:3000/q

# Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
